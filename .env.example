APP_NAME=PromptFlow API
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./promptflow.db

# "local" funciona sem chave e serve para demonstração/testes.
# Use "openai_compatible" para consumir uma API LLM real compatível com
# o formato /chat/completions.
LLM_PROVIDER=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

